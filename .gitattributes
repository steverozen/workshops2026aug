# SCM syntax highlighting & preventing 3-way merges
pixi.lock merge=binary linguist-language=YAML linguist-generated=true -diff

# Large binary teaching assets, stored in git-lfs.
# The tutorial .html files in the same tree are gitignored instead, see .gitignore.
slides/wed_morning/wed_morn_tutorials/data/*.rds filter=lfs diff=lfs merge=lfs -text
